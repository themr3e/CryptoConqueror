# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quantlive

# ── Twelve Data (Gold/XAUUSD only) ────────────────────────────────────────
# LEAVE BLANK if you are only trading crypto — not needed at all.
# Sign up at twelvedata.com (free) only if you want Gold signals.
TWELVE_DATA_API_KEY=

# ── Telegram (optional) ───────────────────────────────────────────────────
# Get from @BotFather on Telegram. Leave blank to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false          # set true on Railway/cloud

# ── Trading ───────────────────────────────────────────────────────────────
ACCOUNT_BALANCE=100000.0

# ── Crypto Futures (Binance) ──────────────────────────────────────────────
# No API key needed — Binance public endpoints are free with no signup.
# Just set CRYPTO_ENABLED=true and choose your symbols.
CRYPTO_ENABLED=true
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT

# API keys only needed for real order execution (future feature — leave blank now)
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

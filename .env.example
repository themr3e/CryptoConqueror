# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quantlive

# ── Twelve Data (XAUUSD candles) ──────────────────────────────────────────
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# ── Telegram (optional) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false

# ── Trading ───────────────────────────────────────────────────────────────
ACCOUNT_BALANCE=100000.0

# ── Crypto Futures (Binance) ──────────────────────────────────────────────
# Set CRYPTO_ENABLED=true to activate the crypto pipeline.
# Public candle data requires NO API key. Keys are for future order execution.
CRYPTO_ENABLED=false
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

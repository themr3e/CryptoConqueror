# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quantlive

# ── Twelve Data (Gold/XAUUSD only) ────────────────────────────────────────
# LEAVE BLANK if you are only trading crypto — not needed at all.
TWELVE_DATA_API_KEY=

# ── Telegram (optional) ───────────────────────────────────────────────────
# Get from @BotFather on Telegram. Leave blank to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false          # set true on Railway/cloud

# ── Trading ───────────────────────────────────────────────────────────────
ACCOUNT_BALANCE=100000.0

# ── Crypto Futures (Binance) ──────────────────────────────────────────────
CRYPTO_ENABLED=true
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT

# ── Binance Order Execution ───────────────────────────────────────────────
# STEP 1: Start with testnet (fake money) — sign up at testnet.binancefuture.com
# STEP 2: Get your testnet API key and secret from that site
# STEP 3: Paste them below
# STEP 4: When ready for real trading, set BINANCE_TESTNET=false and use real keys

BINANCE_TESTNET=true                  # true = testnet (fake money), false = real money
BINANCE_FUTURES_API_KEY=              # your testnet API key
BINANCE_FUTURES_API_SECRET=           # your testnet API secret
BINANCE_LEVERAGE=5                    # leverage per trade (5x = conservative)
